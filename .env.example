# ── Database (Neon / PostgreSQL) ─────────────────────────────────────────────
# Placeholders only. Put real values in .env.local (gitignored).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ── Clerk Authentication ─────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Admin allowlist (comma-separated, lowercase OK) ──────────────────────────
# Server enforcement + interview rate-limit exemption
ADMIN_EMAILS=admin@internscope.ai
# Client UI (Admin Console nav link) — keep in sync with ADMIN_EMAILS
NEXT_PUBLIC_ADMIN_EMAILS=admin@internscope.ai

# ── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=

# ── SMTP Email ───────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@internscope.ai
SMTP_FROM_NAME="InternScope AI"
SMTP_SECURE=true
OPPORTUNITY_EMAIL_THRESHOLD=80
EMAIL_NOTIFICATIONS_ENABLED=true

# ── Payments (Razorpay) — optional until billing is enabled ──────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Rate limiting (optional; falls back to in-memory without Redis) ──────────
# REDIS_URL=

# ── Job scraper ──────────────────────────────────────────────────────────────
# Greenhouse / Lever / Ashby / SmartRecruiters / Workday / JobVetta
SCRAPING_ENABLED=false
JOBVETTA_API_KEY=
# JOBVETTA_MAX_REQUESTS=40
# JOBVETTA_FETCH_DETAILS=true
# INGESTION_LOG_LEVEL=WARN
