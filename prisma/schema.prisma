// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../lib/generated/prisma"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum OpportunityType {
  INTERNSHIP
  NEW_GRAD
  SCHOLARSHIP
  FELLOWSHIP
  HACKATHON
  RESEARCH
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFERED
  REJECTED
}

enum NotificationType {
  SYSTEM
  ALERT
  APPLICATION_DEADLINE
  MATCH_ACCURACY
}

enum RemoteType {
  REMOTE
  HYBRID
  ONSITE
}

model User {
  id                 String             @id @default(uuid())
  clerkId            String             @unique
  email              String             @unique
  role               Role               @default(USER)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  profile            Profile?
  savedOpportunities SavedOpportunity[]
  applications       Application[]
  notifications      Notification[]
  emailPreference    EmailPreference?
  isActive           Boolean            @default(true)
}

model Profile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName      String?
  lastName       String?
  avatarUrl      String?
  resumeUrl      String?
  githubUrl      String?
  linkedinUrl    String?
  portfolioUrl   String?
  skills         String[]
  graduationYear Int?
  major          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Company {
  id            String        @id @default(uuid())
  name          String        @unique
  logoUrl       String?
  websiteUrl    String?
  careerPageUrl String?
  industry      String?
  description   String?
  country       String?
  state         String?
  city          String?
  companySize   String?       @default("1-10")
  foundedYear   Int?
  linkedinUrl   String?
  twitterUrl    String?
  githubUrl     String?
  isVerified    Boolean       @default(false)
  hiringStatus  String        @default("HIRING") // e.g. "HIRING", "NOT_HIRING", "FREEZE"
  isArchived    Boolean       @default(false)
  tags          String[]      @default([])
  opportunities Opportunity[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([name])
  @@index([websiteUrl])
  @@index([linkedinUrl])
  @@index([careerPageUrl])
  @@index([isArchived])
}

model Opportunity {
  id             String             @id @default(uuid())
  title          String
  type           OpportunityType
  companyId      String
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  description    String?
  requirements   String?
  location       String
  remoteType     RemoteType
  salaryRange    String?
  benefits       String?
  applicationUrl String
  deadline       DateTime?
  isActive       Boolean            @default(true)
  isArchived     Boolean            @default(false)
  tags           String[]           @default([])
  savedByUsers   SavedOpportunity[]
  applications   Application[]
  enrichment     OpportunityEnrichment?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([deadline])
  @@index([createdAt])
  @@index([location])
  @@index([type])
  @@index([isArchived])
}

model SavedOpportunity {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  savedAt       DateTime    @default(now())

  @@unique([userId, opportunityId])
}

model Application {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  status        ApplicationStatus @default(SAVED)
  notes         String?
  appliedAt     DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([userId, opportunityId])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([createdAt])
}

model EmailPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyDigest      Boolean  @default(true)
  instantAlerts     Boolean  @default(true)
  deadlineReminders Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum JobStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model IngestionJob {
  id               String    @id @default(uuid())
  provider         String    // "greenhouse", "lever", "ashby", "all"
  status           JobStatus @default(RUNNING)
  triggerId        String?   // Trigger.dev run ID if available
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  durationMs       Int?
  fetchedCount     Int       @default(0)
  importedCount    Int       @default(0)
  duplicateCount   Int       @default(0)
  failedCount      Int       @default(0)
  validationErrors Json?     // Array/Object of validation failures
  error            String?   // Stack trace / error message if FAILED
  logs             Json?     // Array of structured runtime logs
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([provider])
  @@index([status])
  @@index([createdAt])
}

enum EnrichmentStatus {
  RUNNING
  COMPLETED
  FAILED
}

model OpportunityEnrichment {
  id              String           @id @default(uuid())
  opportunityId   String           @unique
  opportunity     Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  status          EnrichmentStatus @default(RUNNING)
  skills          String[]         @default([]) // Extracted skills
  techStack       Json?            // Frontend, Backend, Database, Cloud, DevOps, Mobile, AI, DataEngineering
  experienceLevel String?          // Intern, Entry Level, Junior, Mid Level, Senior, Lead, Manager
  employmentType  String?          // Internship, Full-Time, Part-Time, Contract, Freelance
  remoteType      String?          // Remote, Hybrid, Onsite, Unknown
  salaryMin       Float?
  salaryMax       Float?
  salaryCurrency  String?          // USD, EUR, etc.
  salaryPeriod    String?          // HOURLY, MONTHLY, ANNUAL
  tags            String[]         @default([]) // Tags
  qualityScore    Float            @default(0.0)
  reasoning       String?          // Reasoning metadata
  provider        String           // Gemini, OpenAI, Anthropic, Mock
  model           String           // Model name used
  tokensUsed      Int              @default(0)
  latencyMs       Int              @default(0)
  estimatedCost   Float            @default(0.0)
  error           String?          // Error message if failed
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([qualityScore])
  @@index([createdAt])
}


