generator client {
  provider            = "prisma-client"
  output              = "../lib/generated/prisma"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(uuid())
  clerkId              String                @unique
  email                String                @unique
  role                 Role                  @default(USER)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  isActive             Boolean               @default(true)
  aiActionLogs         AIActionLog[]
  applications         Application[]
  careerAnalysis       CareerAnalysis?
  careerGoals          CareerGoal[]
  careerInsights       CareerInsight[]
  careerSnapshots      CareerSnapshot[]
  copilotConversations CopilotConversation[]
  coverLetters         CoverLetter[]
  emailPreference      EmailPreference?
  interviewSessions    InterviewSession[]
  notifications        Notification[]
  profile              Profile?
  resumes              Resume[]
  resumeOptimizations  ResumeOptimization[]
  savedOpportunities   SavedOpportunity[]
  weeklyCareerReports  WeeklyCareerReport[]
  targetCompanies      TargetCompany[]
}

model Profile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  firstName             String?
  lastName              String?
  avatarUrl             String?
  resumeUrl             String?
  githubUrl             String?
  linkedinUrl           String?
  portfolioUrl          String?
  skills                String[]
  graduationYear        Int?
  major                 String?
  university            String?
  degree                String?
  branch                String?
  cgpa                  Float?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  bio                   String?
  employmentPreferences String[]
  experienceLevel       String?
  headline              String?
  preferredLocations    String[]
  preferredTechnologies String[]
  remotePreferences     String[]
  salaryExpectations    String?
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id            String        @id @default(uuid())
  name          String        @unique
  logoUrl       String?
  websiteUrl    String?
  industry      String?
  description   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  careerPageUrl String?
  city          String?
  companySize   String?       @default("1-10")
  country       String?
  foundedYear   Int?
  githubUrl     String?
  hiringStatus  String        @default("HIRING")
  isArchived    Boolean       @default(false)
  isVerified    Boolean       @default(false)
  linkedinUrl   String?
  state         String?
  tags          String[]      @default([])
  twitterUrl    String?
  opportunities Opportunity[]
  targetUsers   TargetCompany[]

  @@index([name])
  @@index([websiteUrl])
  @@index([linkedinUrl])
  @@index([careerPageUrl])
  @@index([isArchived])
}

model Opportunity {
  id                  String                 @id @default(uuid())
  title               String
  type                OpportunityType
  companyId           String
  description         String?
  requirements        String?
  location            String
  remoteType          RemoteType
  salaryRange         String?
  benefits            String?
  applicationUrl      String
  deadline            DateTime?
  isActive            Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  isArchived          Boolean                @default(false)
  tags                String[]               @default([])
  applications        Application[]
  coverLetters        CoverLetter[]
  interviewSessions   InterviewSession[]
  matches             JobMatch[]
  company             Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enrichment          OpportunityEnrichment?
  resumeOptimizations ResumeOptimization[]
  savedByUsers        SavedOpportunity[]

  @@index([deadline])
  @@index([createdAt])
  @@index([location])
  @@index([type])
  @@index([isArchived])
}

model SavedOpportunity {
  id            String      @id @default(uuid())
  userId        String
  opportunityId String
  savedAt       DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
}

model Application {
  id            String            @id @default(uuid())
  userId        String
  opportunityId String
  status        ApplicationStatus @default(DISCOVERED)
  notes         String?
  appliedAt     DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model EmailPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  emailDestination  String?
  weeklyDigest      Boolean  @default(true)
  instantAlerts     Boolean  @default(true)
  deadlineReminders Boolean  @default(true)
  newOpportunities  Boolean  @default(true)
  applicationStatus Boolean  @default(true)
  interviewReminders Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IngestionJob {
  id               String    @id @default(uuid())
  provider         String
  status           JobStatus @default(RUNNING)
  triggerId        String?
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  durationMs       Int?
  fetchedCount     Int       @default(0)
  importedCount    Int       @default(0)
  duplicateCount   Int       @default(0)
  failedCount      Int       @default(0)
  validationErrors Json?
  error            String?
  logs             Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([provider])
  @@index([status])
  @@index([createdAt])
}

model OpportunityEnrichment {
  id              String           @id @default(uuid())
  opportunityId   String           @unique
  status          EnrichmentStatus @default(RUNNING)
  skills          String[]         @default([])
  techStack       Json?
  experienceLevel String?
  employmentType  String?
  remoteType      String?
  salaryMin       Float?
  salaryMax       Float?
  salaryCurrency  String?
  salaryPeriod    String?
  tags            String[]         @default([])
  qualityScore    Float            @default(0.0)
  reasoning       String?
  provider        String
  model           String
  tokensUsed      Int              @default(0)
  latencyMs       Int              @default(0)
  estimatedCost   Float            @default(0.0)
  error           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  opportunity     Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([qualityScore])
  @@index([createdAt])
}

model SearchLog {
  id           String   @id @default(uuid())
  query        String
  filters      Json?
  resultsCount Int      @default(0)
  userId       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([query])
}

model Resume {
  id                  String               @id @default(uuid())
  userId              String
  fileName            String
  filePath            String
  fileSize            Int
  mimeType            String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  version             Int                  @default(1)
  rawText             String?
  isParsed            Boolean              @default(false)
  parsedAt            DateTime?
  parsingError        String?
  parserVersion       String?
  aiProvider          String?
  confidenceScore     Float?
  processingTimeMs    Int?
  tokensConsumed      Int?
  structuredData      Json?
  qualityScore        Float?
  qualityFeedback     Json?
  careerAnalyses      CareerAnalysis[]
  careerSnapshots     CareerSnapshot[]
  matches             JobMatch[]
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeOptimizations ResumeOptimization[]

  @@index([userId])
  @@index([createdAt])
}

model JobMatch {
  id                     String      @id @default(uuid())
  resumeId               String
  opportunityId          String
  overallScore           Float
  skillScore             Float
  techScore              Float
  experienceScore        Float
  locationScore          Float
  employmentTypeScore    Float
  missingSkills          String[]    @default([])
  missingTechnologies    String[]    @default([])
  niceToHaveSkills       String[]    @default([])
  strengthAreas          String[]    @default([])
  improvementSuggestions String[]    @default([])
  matchExplanation       String?
  createdAt              DateTime    @default(now())
  opportunity            Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  resume                 Resume      @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, opportunityId])
  @@index([resumeId])
  @@index([opportunityId])
}

model CareerAnalysis {
  id                      String            @id @default(uuid())
  userId                  String            @unique
  resumeId                String
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  summary                 String?
  strengths               String[]          @default([])
  weaknesses              String[]          @default([])
  suitableRoles           String[]          @default([])
  careerPaths             Json?
  hiringIndustries        String[]          @default([])
  estimatedReadiness      Float?
  missingSkills           String[]          @default([])
  missingTechnologies     String[]          @default([])
  frequentSkills          String[]          @default([])
  criticalGaps            String[]          @default([])
  strengthAreas           String[]          @default([])
  interviewReadinessScore Float?
  technicalReadiness      Float?
  behavioralReadiness     Float?
  portfolioStrength       Float?
  projectQuality          Float?
  communicationReadiness  Float?
  careerScore             Float?
  resumeQualityScore      Float?
  jobMatchAvg             Float?
  skillCoverageScore      Float?
  projectQualityScore     Float?
  experienceScore         Float?
  consistencyScore        Float?
  provider                String?
  model                   String?
  tokensUsed              Int               @default(0)
  latencyMs               Int               @default(0)
  estimatedCost           Float             @default(0.0)
  resume                  Resume            @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmaps                LearningRoadmap[]

  @@index([userId])
  @@index([resumeId])
}

model CareerSnapshot {
  id                 String   @id @default(uuid())
  userId             String
  resumeId           String
  careerScore        Float
  overallMatchScore  Float
  resumeQualityScore Float
  analysisData       Json
  createdAt          DateTime @default(now())
  resume             Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resumeId])
  @@index([createdAt])
}

model LearningRoadmap {
  id               String         @id @default(uuid())
  careerAnalysisId String
  skillName        String
  steps            Json
  estimatedHours   Int
  difficulty       String
  prerequisites    String[]       @default([])
  expectedImpact   String?
  learningOrder    Int
  analysis         CareerAnalysis @relation(fields: [careerAnalysisId], references: [id], onDelete: Cascade)

  @@index([careerAnalysisId])
}

model CareerInsight {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  type      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model InterviewSession {
  id                 String              @id @default(uuid())
  userId             String
  opportunityId      String?
  title              String
  status             String
  sessionLength      Int
  difficulty         String
  categories         String[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  overallScore       Float?
  technicalScore     Float?
  behavioralScore    Float?
  communicationScore Float?
  confidenceScore    Float?
  questions          InterviewQuestion[]
  opportunity        Opportunity?        @relation(fields: [opportunityId], references: [id])
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary            InterviewSummary?

  @@index([userId])
  @@index([opportunityId])
  @@index([createdAt])
}

model InterviewQuestion {
  id           String               @id @default(uuid())
  sessionId    String
  category     String
  text         String
  difficulty   String
  sampleAnswer String?
  order        Int
  createdAt    DateTime             @default(now())
  answer       InterviewAnswer?
  evaluation   InterviewEvaluation?
  session      InterviewSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model InterviewAnswer {
  id         String            @id @default(uuid())
  questionId String            @unique
  userAnswer String
  createdAt  DateTime          @default(now())
  question   InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model InterviewEvaluation {
  id                   String            @id @default(uuid())
  questionId           String            @unique
  score                Float
  technicalAccuracy    Float
  communication        Float
  completeness         Float
  problemSolving       Float
  confidence           Float
  structure            Float
  strengths            String[]          @default([])
  weaknesses           String[]          @default([])
  improvedAnswer       String?
  starMethodFollowed   Boolean           @default(false)
  starSituation        String?
  starTask             String?
  starAction           String?
  starResult           String?
  starCoachingFeedback String?
  provider             String?
  model                String?
  latencyMs            Int               @default(0)
  tokensUsed           Int               @default(0)
  question             InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model InterviewSummary {
  id                  String           @id @default(uuid())
  sessionId           String           @unique
  overallFeedback     String
  keyStrengths        String[]         @default([])
  keyWeaknesses       String[]         @default([])
  recommendedPractice String[]         @default([])
  provider            String?
  model               String?
  latencyMs           Int              @default(0)
  tokensUsed          Int              @default(0)
  estimatedCost       Float            @default(0.0)
  session             InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ResumeOptimization {
  id            String                      @id @default(uuid())
  userId        String
  resumeId      String
  opportunityId String?
  title         String
  atsScore      Float?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  atsAnalysis   ATSAnalysis?
  opportunity   Opportunity?                @relation(fields: [opportunityId], references: [id])
  resume        Resume                      @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user          User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections      ResumeOptimizationSection[]

  @@index([userId])
  @@index([resumeId])
  @@index([opportunityId])
  @@index([createdAt])
}

model ResumeOptimizationSection {
  id               String             @id @default(uuid())
  optimizationId   String
  sectionType      String
  originalContent  String
  optimizedContent String
  bulletRewrites   Json?
  createdAt        DateTime           @default(now())
  optimization     ResumeOptimization @relation(fields: [optimizationId], references: [id], onDelete: Cascade)

  @@index([optimizationId])
}

model ATSAnalysis {
  id                      String             @id @default(uuid())
  optimizationId          String             @unique
  atsScore                Float
  keywordMatchScore       Float
  missingKeywords         String[]
  weakBullets             String[]
  strongBullets           String[]
  missingSkills           String[]
  suggestedProjects       String[]
  suggestedCertifications String[]
  formattingIssues        String[]
  improvementChecklist    String[]
  provider                String?
  model                   String?
  latencyMs               Int                @default(0)
  tokensUsed              Int                @default(0)
  estimatedCost           Float              @default(0.0)
  optimization            ResumeOptimization @relation(fields: [optimizationId], references: [id], onDelete: Cascade)
}

model CoverLetter {
  id            String               @id @default(uuid())
  userId        String
  opportunityId String?
  title         String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  opportunity   Opportunity?         @relation(fields: [opportunityId], references: [id])
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions      CoverLetterVersion[]

  @@index([userId])
  @@index([opportunityId])
  @@index([createdAt])
}

model CoverLetterVersion {
  id            String      @id @default(uuid())
  coverLetterId String
  version       Int
  content       String
  style         String
  createdAt     DateTime    @default(now())
  provider      String?
  model         String?
  latencyMs     Int         @default(0)
  tokensUsed    Int         @default(0)
  estimatedCost Float       @default(0.0)
  coverLetter   CoverLetter @relation(fields: [coverLetterId], references: [id], onDelete: Cascade)

  @@index([coverLetterId])
}

model CareerGoal {
  id                 String    @id @default(uuid())
  userId             String
  title              String
  targetDate         DateTime?
  status             String
  progress           Float     @default(0.0)
  missingSkills      String[]
  estimatedReadiness Float?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CopilotConversation {
  id        String           @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  CopilotMessage[]

  @@index([userId])
  @@index([createdAt])
}

model CopilotMessage {
  id             String              @id @default(uuid())
  conversationId String
  sender         String
  content        String
  createdAt      DateTime            @default(now())
  provider       String?
  model          String?
  latencyMs      Int                 @default(0)
  tokensUsed     Int                 @default(0)
  estimatedCost  Float               @default(0.0)
  contextSize    Int                 @default(0)
  conversation   CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model WeeklyCareerReport {
  id                   String   @id @default(uuid())
  userId               String
  startDate            DateTime
  endDate              DateTime
  careerScoreDelta     Float    @default(0.0)
  resumeImprovements   String[]
  interviewProgress    String
  newMatchingJobsCount Int      @default(0)
  skillsLearned        String[]
  recommendations      String[]
  provider             String?
  model                String?
  latencyMs            Int      @default(0)
  tokensUsed           Int      @default(0)
  estimatedCost        Float    @default(0.0)
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model AIActionLog {
  id         String   @id @default(uuid())
  userId     String
  actionType String
  status     String
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model FeatureFlag {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String?
  isEnabled      Boolean  @default(false)
  rolloutPercent Int      @default(100)
  allowedRoles   String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SystemAuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  status    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model UserFeedback {
  id         String   @id @default(uuid())
  userId     String?
  type       String
  content    String
  rating     Int?
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model BetaInvitation {
  id        String   @id @default(uuid())
  email     String   @unique
  token     String   @unique
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum OpportunityType {
  INTERNSHIP
  NEW_GRAD
  SCHOLARSHIP
  FELLOWSHIP
  HACKATHON
  RESEARCH
}

enum ApplicationStatus {
  DISCOVERED
  SHORTLISTED
  PREPARING
  APPLIED
  OA
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum NotificationType {
  SYSTEM
  ALERT
  APPLICATION_DEADLINE
  MATCH_ACCURACY
}

enum RemoteType {
  REMOTE
  HYBRID
  ONSITE
}

enum JobStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum EnrichmentStatus {
  RUNNING
  COMPLETED
  FAILED
}

model TargetCompany {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}
