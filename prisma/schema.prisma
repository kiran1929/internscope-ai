// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../lib/generated/prisma"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum OpportunityType {
  INTERNSHIP
  NEW_GRAD
  SCHOLARSHIP
  FELLOWSHIP
  HACKATHON
  RESEARCH
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFERED
  REJECTED
  ACCEPTED
}

enum NotificationType {
  SYSTEM
  ALERT
  APPLICATION_DEADLINE
  MATCH_ACCURACY
}

enum RemoteType {
  REMOTE
  HYBRID
  ONSITE
}

model User {
  id                 String             @id @default(uuid())
  clerkId            String             @unique
  email              String             @unique
  role               Role               @default(USER)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  profile            Profile?
  savedOpportunities SavedOpportunity[]
  applications       Application[]
  notifications      Notification[]
  emailPreference    EmailPreference?
  isActive           Boolean            @default(true)
  resumes            Resume[]
  careerAnalysis     CareerAnalysis?
  careerSnapshots    CareerSnapshot[]
  careerInsights     CareerInsight[]
  interviewSessions  InterviewSession[]
}

model Profile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName      String?
  lastName       String?
  avatarUrl      String?
  resumeUrl      String?
  githubUrl      String?
  linkedinUrl    String?
  portfolioUrl   String?
  skills         String[]
  graduationYear Int?
  major          String?
  headline       String?
  bio            String?
  preferredTechnologies String[]
  preferredLocations    String[]
  employmentPreferences String[]
  remotePreferences     String[]
  salaryExpectations    String?
  experienceLevel       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Company {
  id            String        @id @default(uuid())
  name          String        @unique
  logoUrl       String?
  websiteUrl    String?
  careerPageUrl String?
  industry      String?
  description   String?
  country       String?
  state         String?
  city          String?
  companySize   String?       @default("1-10")
  foundedYear   Int?
  linkedinUrl   String?
  twitterUrl    String?
  githubUrl     String?
  isVerified    Boolean       @default(false)
  hiringStatus  String        @default("HIRING") // e.g. "HIRING", "NOT_HIRING", "FREEZE"
  isArchived    Boolean       @default(false)
  tags          String[]      @default([])
  opportunities Opportunity[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([name])
  @@index([websiteUrl])
  @@index([linkedinUrl])
  @@index([careerPageUrl])
  @@index([isArchived])
}

model Opportunity {
  id             String             @id @default(uuid())
  title          String
  type           OpportunityType
  companyId      String
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  description    String?
  requirements   String?
  location       String
  remoteType     RemoteType
  salaryRange    String?
  benefits       String?
  applicationUrl String
  deadline       DateTime?
  isActive       Boolean            @default(true)
  isArchived     Boolean            @default(false)
  tags           String[]           @default([])
  savedByUsers   SavedOpportunity[]
  applications   Application[]
  enrichment     OpportunityEnrichment?
  matches        JobMatch[]
  interviewSessions InterviewSession[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([deadline])
  @@index([createdAt])
  @@index([location])
  @@index([type])
  @@index([isArchived])
}

model SavedOpportunity {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  savedAt       DateTime    @default(now())

  @@unique([userId, opportunityId])
}

model Application {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  status        ApplicationStatus @default(SAVED)
  notes         String?
  appliedAt     DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([userId, opportunityId])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([createdAt])
}

model EmailPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyDigest      Boolean  @default(true)
  instantAlerts     Boolean  @default(true)
  deadlineReminders Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum JobStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model IngestionJob {
  id               String    @id @default(uuid())
  provider         String    // "greenhouse", "lever", "ashby", "all"
  status           JobStatus @default(RUNNING)
  triggerId        String?   // Trigger.dev run ID if available
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  durationMs       Int?
  fetchedCount     Int       @default(0)
  importedCount    Int       @default(0)
  duplicateCount   Int       @default(0)
  failedCount      Int       @default(0)
  validationErrors Json?     // Array/Object of validation failures
  error            String?   // Stack trace / error message if FAILED
  logs             Json?     // Array of structured runtime logs
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([provider])
  @@index([status])
  @@index([createdAt])
}

enum EnrichmentStatus {
  RUNNING
  COMPLETED
  FAILED
}

model OpportunityEnrichment {
  id              String           @id @default(uuid())
  opportunityId   String           @unique
  opportunity     Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  status          EnrichmentStatus @default(RUNNING)
  skills          String[]         @default([]) // Extracted skills
  techStack       Json?            // Frontend, Backend, Database, Cloud, DevOps, Mobile, AI, DataEngineering
  experienceLevel String?          // Intern, Entry Level, Junior, Mid Level, Senior, Lead, Manager
  employmentType  String?          // Internship, Full-Time, Part-Time, Contract, Freelance
  remoteType      String?          // Remote, Hybrid, Onsite, Unknown
  salaryMin       Float?
  salaryMax       Float?
  salaryCurrency  String?          // USD, EUR, etc.
  salaryPeriod    String?          // HOURLY, MONTHLY, ANNUAL
  tags            String[]         @default([]) // Tags
  qualityScore    Float            @default(0.0)
  reasoning       String?          // Reasoning metadata
  provider        String           // Gemini, OpenAI, Anthropic, Mock
  model           String           // Model name used
  tokensUsed      Int              @default(0)
  latencyMs       Int              @default(0)
  estimatedCost   Float            @default(0.0)
  error           String?          // Error message if failed
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([qualityScore])
  @@index([createdAt])
}

model SearchLog {
  id           String   @id @default(uuid())
  query        String
  filters      Json?    // Stores the filters applied during search
  resultsCount Int      @default(0)
  userId       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([query])
}

model Resume {
  id               String     @id @default(uuid())
  userId           String
  fileName         String
  filePath         String
  fileSize         Int
  mimeType         String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  version          Int        @default(1)
  rawText          String?    // DB text representation
  isParsed         Boolean    @default(false)
  parsedAt         DateTime?
  parsingError     String?
  parserVersion    String?
  aiProvider       String?
  confidenceScore  Float?
  processingTimeMs Int?
  tokensConsumed   Int?
  structuredData   Json?      // Parsed sections JSON payload
  qualityScore     Float?     // Quality evaluation score
  qualityFeedback  Json?      // Actionable feedback JSON array
  
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches          JobMatch[]
  careerAnalyses   CareerAnalysis[]
  careerSnapshots  CareerSnapshot[]

  @@index([userId])
  @@index([createdAt])
}

model JobMatch {
  id                     String      @id @default(uuid())
  resumeId               String
  opportunityId          String
  overallScore           Float       // Overall matching score (0-100)
  skillScore             Float
  techScore              Float
  experienceScore        Float
  locationScore          Float
  employmentTypeScore    Float
  missingSkills          String[]    @default([])
  missingTechnologies    String[]    @default([])
  niceToHaveSkills       String[]    @default([])
  strengthAreas          String[]    @default([])
  improvementSuggestions String[]    @default([])
  matchExplanation       String?
  createdAt              DateTime    @default(now())

  resume                 Resume      @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  opportunity            Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([resumeId, opportunityId])
  @@index([resumeId])
  @@index([opportunityId])
}

model CareerAnalysis {
  id                 String            @id @default(uuid())
  userId             String            @unique
  resumeId           String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  
  // AI Career Analysis fields
  summary            String?           
  strengths          String[]          @default([])
  weaknesses         String[]          @default([])
  suitableRoles      String[]          @default([])
  careerPaths        Json?             // Array of suggested paths
  hiringIndustries   String[]          @default([])
  estimatedReadiness Float?
  
  // Skill Gap Analysis fields
  missingSkills      String[]          @default([])
  missingTechnologies String[]         @default([])
  frequentSkills     String[]          @default([])
  criticalGaps       String[]          @default([])
  strengthAreas      String[]          @default([])
  
  // Interview Readiness fields
  interviewReadinessScore Float?
  technicalReadiness     Float?
  behavioralReadiness    Float?
  portfolioStrength      Float?
  projectQuality         Float?
  communicationReadiness Float?

  // Career Score fields
  careerScore        Float?
  resumeQualityScore Float?
  jobMatchAvg        Float?
  skillCoverageScore Float?
  projectQualityScore Float?
  experienceScore    Float?
  consistencyScore   Float?

  // Observability metadata
  provider           String?
  model              String?
  tokensUsed         Int               @default(0)
  latencyMs          Int               @default(0)
  estimatedCost      Float             @default(0.0)
  
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume             Resume            @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  roadmaps           LearningRoadmap[]

  @@index([userId])
  @@index([resumeId])
}

model CareerSnapshot {
  id                 String   @id @default(uuid())
  userId             String
  resumeId           String
  careerScore        Float
  overallMatchScore  Float
  resumeQualityScore Float
  analysisData       Json     // Stores the full serialized snapshot payload
  createdAt          DateTime @default(now())
  
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume             Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resumeId])
  @@index([createdAt])
}

model LearningRoadmap {
  id               String   @id @default(uuid())
  careerAnalysisId String
  skillName        String
  steps            Json     // Steps sequence JSON array (step name, details, key lessons)
  estimatedHours   Int
  difficulty       String   // Beginner, Intermediate, Advanced
  prerequisites    String[] @default([])
  expectedImpact   String?  
  learningOrder    Int
  
  analysis         CareerAnalysis @relation(fields: [careerAnalysisId], references: [id], onDelete: Cascade)

  @@index([careerAnalysisId])
}

model CareerInsight {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String   
  type      String   // milestone, warning, recommendation
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model InterviewSession {
  id                  String             @id @default(uuid())
  userId              String
  opportunityId       String?
  title               String
  status              String             // PENDING, IN_PROGRESS, COMPLETED, FAILED
  sessionLength       Int                // 5, 10, custom
  difficulty          String             // Easy, Medium, Hard
  categories          String[]           // Technical, Behavioral, etc.
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  
  // Scores
  overallScore        Float?
  technicalScore      Float?
  behavioralScore     Float?
  communicationScore  Float?
  confidenceScore     Float?
  
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity         Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  questions           InterviewQuestion[]
  summary             InterviewSummary?

  @@index([userId])
  @@index([opportunityId])
  @@index([createdAt])
}

model InterviewQuestion {
  id             String             @id @default(uuid())
  sessionId      String
  category       String             // Technical, Behavioral, etc.
  text           String             
  difficulty     String
  sampleAnswer   String?            
  order          Int
  createdAt      DateTime           @default(now())
  
  session        InterviewSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answer         InterviewAnswer?
  evaluation     InterviewEvaluation?

  @@index([sessionId])
}

model InterviewAnswer {
  id          String            @id @default(uuid())
  questionId  String            @unique
  userAnswer  String            
  createdAt   DateTime          @default(now())
  
  question    InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model InterviewEvaluation {
  id                   String            @id @default(uuid())
  questionId           String            @unique
  score                Float             // Overall question answer score
  
  // Sub-scores
  technicalAccuracy    Float
  communication        Float
  completeness         Float
  problemSolving       Float
  confidence           Float
  structure            Float
  
  strengths            String[]          @default([])
  weaknesses           String[]          @default([])
  improvedAnswer       String?           
  
  // STAR coaching details
  starMethodFollowed   Boolean           @default(false)
  starSituation        String?           
  starTask             String?           
  starAction           String?           
  starResult           String?           
  starCoachingFeedback String?           
  
  // Observability metadata
  provider             String?
  model                String?
  latencyMs            Int               @default(0)
  tokensUsed           Int               @default(0)
  
  question             InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model InterviewSummary {
  id                 String           @id @default(uuid())
  sessionId          String           @unique
  
  overallFeedback    String           
  keyStrengths       String[]         @default([])
  keyWeaknesses      String[]         @default([])
  recommendedPractice String[]        @default([])
  
  // Observability metadata
  provider           String?
  model              String?
  latencyMs          Int              @default(0)
  tokensUsed         Int              @default(0)
  estimatedCost      Float            @default(0.0)
  
  session            InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}






