# ── Database (Neon / PostgreSQL) ─────────────────────────────────────────────
# Use placeholders only in this file. Put real values in .env.local (gitignored).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ── Clerk Authentication ─────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=

# ── SMTP Email ───────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@internscope.ai
SMTP_FROM_NAME="InternScope AI"
SMTP_SECURE=true

# Minimum match % to trigger opportunity email (default 80)
OPPORTUNITY_EMAIL_THRESHOLD=80
EMAIL_NOTIFICATIONS_ENABLED=true

# ── Job scraper ──────────────────────────────────────────────────────────────
# Greenhouse / Lever / Ashby / SmartRecruiters / Workday / JobVetta
# false = no-op for manual + scheduled runs. true = scheduled sync (IST).
SCRAPING_ENABLED=false

# JobVetta (https://www.jobvetta.com/api) — internship search only
# Free tier: limited requests/day. Optional detail fetches consume budget.
JOBVETTA_API_KEY=
# JOBVETTA_MAX_REQUESTS=40
# JOBVETTA_FETCH_DETAILS=true

# Optional log verbosity for long syncs: DEBUG | INFO | WARN | ERROR
# INGESTION_LOG_LEVEL=WARN
